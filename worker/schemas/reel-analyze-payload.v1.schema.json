{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "source": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 5,
              "maxLength": 600
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 8,
              "maxLength": 2000
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        }
      ]
    },
    "speech": {
      "default": false,
      "type": "boolean"
    },
    "output": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string",
          "minLength": 5,
          "maxLength": 600
        }
      },
      "required": [
        "dir"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "reference",
    "source",
    "output"
  ],
  "additionalProperties": false
}
