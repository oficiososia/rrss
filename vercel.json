{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "functions": {
    "api/cutout-mask.ts": {
      "maxDuration": 60,
      "includeFiles": "{public/models/isnet-general-use-u8.onnx,node_modules/onnxruntime-node/bin/napi-v6/linux/x64/**}",
      "excludeFiles": "node_modules/onnxruntime-node/bin/napi-v6/{win32,darwin,linux/arm64}/**"
    }
  }
}
