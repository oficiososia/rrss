# Configuración de la función ai-generate para la prueba de extremo a extremo
# LOCAL (Playwright la pasa con `supabase functions serve --env-file`).
# SIN SECRETOS: solo interruptores. Las claves del stack local las pone la CLI.
#
# Proveedor simulado de pruebas locales: solo arranca contra un Supabase local
# (ver supabase/functions/_shared/ai/text/local-test.ts).
AI_E2E_SIMULATED_PROVIDER=true
# CORS: la aplicación de la prueba se sirve en este origen.
AI_ALLOWED_ORIGIN=http://127.0.0.1:5273

# Publicación (Fase 3): Graph API de Meta SIMULADA, solo contra un Supabase
# local (ver supabase/functions/_shared/social/local-test.ts). Sin aplicación de
# Meta ni claves: la clave de cifrado de los tokens es una fija de pruebas.
SOCIAL_E2E_SIMULATED_GRAPH=true
SOCIAL_CALLBACK_URL=http://127.0.0.1:55321/functions/v1/social-connect/callback
SOCIAL_APP_URL=http://127.0.0.1:5273
SOCIAL_ALLOWED_ORIGIN=http://127.0.0.1:5273
